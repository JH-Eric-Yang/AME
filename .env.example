# AME configuration. Copy this file to .env in the repository root, or run
# scripts/setup.sh to make .env for you. The server and the client both
# read this one file.

# ── Required ───────────────────────────────────────────
# The PostgreSQL connection string.
DATABASE_URL=postgresql://ame:ame@localhost:5432/ame
# The Redis connection string.
REDIS_URL=redis://localhost:6379
# A long random string. The server signs login tokens with it.
# Make one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string

# ── Server ─────────────────────────────────────────────
# The port of the Express server (REST API, Socket.IO and uploads).
PORT=3001
# The origin of the client. In production, the server accepts requests only
# from this origin.
CLIENT_URL=http://localhost:5173
# NODE_ENV=production

# ── Client ─────────────────────────────────────────────
# The URL at which the browser reaches the server. Leave it empty in
# development: the client then uses port 3001 on the same host, so a phone on
# the same network can also reach it. In production, set it to the public URL,
# for example https://ame.example.org. The client reads it when you build it.
# VITE_SERVER_URL=

# ── TURN relay (optional) ──────────────────────────────
# Without TURN, a video call can fail on networks that block a direct
# connection. Use coturn with "use-auth-secret".
# TURN_URLS=turn:ame.example.org:3478?transport=udp,turn:ame.example.org:3478?transport=tcp
# TURN_SECRET=the-static-auth-secret-of-coturn
# TURN_TTL_SECONDS=14400
